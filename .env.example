SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Sonnet 4.5 is the compatibility-tested default. Override individual roles only after testing model access.
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-4-5
ANTHROPIC_UTILITY_MODEL=claude-sonnet-4-5
ANTHROPIC_WRITING_MODEL=claude-sonnet-4-5
# Hard cost controls. Three paid searches max per company; one invocation stops
# at $2.50 of measured spend and leaves the rest of the batch queued.
ANTHROPIC_MAX_SEARCHES_PER_COMPANY=3
NIGHTLY_MAX_COST_PER_ACCOUNT_USD=0.12
NIGHTLY_RUN_BUDGET_USD=2.50
# Run tuning. All defaults live in src/lib/run-config.ts; these only override them.
# Companies the model researches per run, scheduled or manual. Default 25.
NIGHTLY_ACCOUNT_LIMIT=25
# Careers sweep (hourly, no model): companies per run, hours before a page is
# read again, and pages read in parallel. Defaults 300 / 24 / 6.
SWEEP_ACCOUNT_LIMIT=300
SWEEP_COOLDOWN_HOURS=24
SWEEP_CONCURRENCY=6
# When a careers page cannot be read, a small model lists the company's roles
# from public job boards: on/off, days between attempts, searches per company,
# and the spend at which one sweep invocation pauses. Defaults true / 7 / 2 / 10.
SWEEP_SEARCH_FALLBACK=true
SWEEP_SEARCH_COOLDOWN_DAYS=7
SWEEP_SEARCH_MAX_SEARCHES=2
SWEEP_RUN_BUDGET_USD=10
ANTHROPIC_SEARCH_MODEL=claude-haiku-4-5
# AI-posts scan inside the sweep: anyone at the company posting publicly about
# AI or automation in their own work. on/off, days between scans, searches.
SWEEP_AI_POSTS=true
SWEEP_AI_POSTS_COOLDOWN_DAYS=7
SWEEP_AI_POSTS_MAX_SEARCHES=2
# Contact enrichment inside the sweep: hiring (companies with target roles or
# AI posts), all, or off; days between refreshes; buyers per company.
SWEEP_CONTACTS=hiring
SWEEP_CONTACTS_COOLDOWN_DAYS=30
SWEEP_CONTACTS_PER_COMPANY=6
# Initial populate (the desk's one-time buttons): searches per company,
# companies per pass, and the spend at which the pass pauses. Defaults 5 / 300 / 25.
ANALYSIS_MODEL=claude-sonnet-4-5
ANALYSIS_SEARCHES=6
ANALYSIS_RUN_BUDGET_USD=100
ANALYSIS_COOLDOWN_DAYS=14
ANALYSIS_CONCURRENCY=2
POPULATE_MAX_SEARCHES=8
POPULATE_ACCOUNT_LIMIT=2000
POPULATE_RUN_BUDGET_USD=150
# Extensive sweep pass: budget per press, searches per scan, and the model
# used for the job-board and AI-posts searches (defaults to the research model).
POPULATE_SWEEP_BUDGET_USD=200
POPULATE_SWEEP_SEARCHES=5
POPULATE_SWEEP_MODEL=claude-sonnet-4-5
# Days before a successfully researched company is eligible again. Must exceed
# the daily cron interval or the same companies are re-checked every night. Default 7.
RESEARCH_COOLDOWN_DAYS=7
# Seconds one scheduled invocation may work before returning with the run still
# open for the next invocation to resume. Default 240 (the route allows 300).
NIGHTLY_TIME_BUDGET_SECONDS=240
# Slack is the recommended morning desk and manual control surface.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Optional: restrict controls and map Slack users to Night Watch owners.
SLACK_ALLOWED_USER_IDS=
SLACK_JOSH_USER_ID=
APOLLO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
APP_URL=http://localhost:3000
# Shared password access. Defaults to mintchip when omitted.
SHARED_PASSWORD=mintchip
# Use a long random value in production to sign session cookies.
AUTH_SECRET=
# Shared web activity is attributed to Josh unless changed here.
SHARED_OWNER_EMAIL=josh@nine-67.com
OPT_OUT_LINE=If this isn't relevant, reply no and I won't follow up.
