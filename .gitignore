# Throwaway analysis scripts. TypeScript imports only resolve from the repo root, so a one-off script that
# reads the target list or exercises a helper has to be written here rather than in a temp directory.
# Ignored so scratch never reaches a commit; nothing here is part of the app.
*-tmp.ts
*-check.ts
*-check.mjs
scratch-*.ts

# The exported sales list. Generated from the target file by scripts/export-sales-list.ts, so it is a
# copy rather than a source — committing it would give the same list two places to disagree.
nine67-sales-list.csv
