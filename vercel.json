{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": null,
  "crons": [
    {
      "path": "/api/cron/company-signals",
      "schedule": "*/20 2-6 * * *"
    },
    {
      "path": "/api/cron/nightly-list",
      "schedule": "*/10 6-9 * * *"
    },
    {
      "path": "/api/cron/morning-send",
      "schedule": "*/10 10-17 * * *"
    },
    {
      "path": "/api/cron/morning",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/replies",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cadences",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/feedback-digest",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/sent-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/notices",
      "schedule": "*/10 11-18 * * 1-5"
    },
    {
      "path": "/api/cron/addresses",
      "schedule": "*/20 * * * *"
    },
    {
      "path": "/api/cron/reddit",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/discovery",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/outreach-recovery",
      "schedule": "0 10,12,14 * * 1-5"
    },
    {
      "path": "/api/cron/calls",
      "schedule": "0 8,12,16 * * 1-5"
    },
    {
      "path": "/api/cron/voice-pilot",
      "schedule": "*/15 13-23 * * 1-5"
    },
    {
      "path": "/api/cron/activity-summary",
      "schedule": "*/10 0-3 * * 2-6"
    }
  ]
}
